* text=auto

# 着色器语言识别
*.effect linguist-language=HLSL

# 语言包统计（强制将 INI 纳入统计）
*.ini linguist-language=INI
*.ini linguist-detectable
data/locale/** linguist-language=INI
data/locale/** linguist-detectable

# 彻底排除 CMake 构建脚本与脚手架，避免污染语言统计
CMakeLists.txt linguist-vendored
CMakeLists.txt -linguist-detectable
*.cmake linguist-vendored
*.cmake -linguist-detectable
cmake/** linguist-vendored
cmake/** -linguist-detectable
CMakePresets.json linguist-vendored
buildspec.json linguist-vendored
.github/** linguist-vendored
.github/** -linguist-detectable
docs/** linguist-documentation

# Markdown 语言统计：默认排除所有文档
*.md -linguist-detectable
*.md linguist-documentation

# 精确指定：仅将指定的两个核心 Markdown 文件纳入语言统计
README.md linguist-language=Markdown
README.md linguist-detectable
README.md -linguist-documentation

.github/workflows/build.md linguist-language=Markdown
.github/workflows/build.md linguist-detectable
.github/workflows/build.md -linguist-documentation
.github/workflows/build.md -linguist-vendored
