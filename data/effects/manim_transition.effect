uniform float4x4 ViewProj;
uniform texture2d tex_a;
uniform texture2d tex_b;

uniform int phase;           // 0: Exit, 1: Pause, 2: Entrance
uniform int exit_mode;       // 0: FadeOut, 1: Uncreate
uniform int enter_mode;      // 0: FadeIn, 1: Create
uniform float progress;      // Normalized 0.0 to 1.0 for the active phase
uniform float4 border_color; // e.g. Mizuiro Water Blue (#7FA8E8, 0.498, 0.659, 0.910, 1.0)
uniform float border_thickness; // Thickness in UV units
uniform float glow_intensity;   // Glow multiplier
uniform float2 canvas_size;     // Screen width, height

uniform int contour_mode;          // 0: GPU XDoG, 1: Fourier Harmonic, 2: Disabled
uniform float contour_sensitivity; // Edge threshold (0.05 to 0.50)
uniform float fill_delay;          // Color infill delay ratio (0.10 to 0.85)

sampler_state textureSampler {
    Filter    = Linear;
    AddressU  = Clamp;
    AddressV  = Clamp;
};

struct VertData {
    float2 uv  : TEXCOORD0;
    float4 pos : POSITION;
};

struct FragData {
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.uv  = v_in.uv;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    return vert_out;
}

// Compute perimeter coordinate s in [0, 4) along rectangle perimeter clockwise starting from top-left (0,0)
float get_perimeter_s(float2 uv)
{
    float u = uv.x;
    float v = uv.y;

    if (v <= u && v <= (1.0 - u)) {
        return u;
    } else if ((1.0 - u) < v && (1.0 - u) <= (1.0 - v)) {
        return 1.0 + v;
    } else if ((1.0 - v) < u && (1.0 - v) < (1.0 - u)) {
        return 2.0 + (1.0 - u);
    } else {
        return 3.0 + (1.0 - v);
    }
}

// Distance from UV to closest border edge, corrected for aspect ratio
float get_border_distance(float2 uv, float aspect)
{
    float dx = min(uv.x, 1.0 - uv.x) * aspect;
    float dy = min(uv.y, 1.0 - uv.y);
    return min(dx, dy);
}

// Grayscale luminance
float get_luma(float3 rgb)
{
    return dot(rgb, float3(0.299, 0.587, 0.114));
}

// Compute internal scene contours using a 3x3 Scharr gradient operator
float get_contour(texture2d tex, float2 uv, float threshold)
{
    float2 step = 1.0 / max(canvas_size, float2(1.0, 1.0));

    // Sample 3x3 luminance
    float l00 = get_luma(tex.Sample(textureSampler, uv + float2(-step.x, -step.y)).rgb);
    float l01 = get_luma(tex.Sample(textureSampler, uv + float2(0.0, -step.y)).rgb);
    float l02 = get_luma(tex.Sample(textureSampler, uv + float2(step.x, -step.y)).rgb);

    float l10 = get_luma(tex.Sample(textureSampler, uv + float2(-step.x, 0.0)).rgb);
    float l12 = get_luma(tex.Sample(textureSampler, uv + float2(step.x, 0.0)).rgb);

    float l20 = get_luma(tex.Sample(textureSampler, uv + float2(-step.x, step.y)).rgb);
    float l21 = get_luma(tex.Sample(textureSampler, uv + float2(0.0, step.y)).rgb);
    float l22 = get_luma(tex.Sample(textureSampler, uv + float2(step.x, step.y)).rgb);

    // Scharr gradient filter
    float gx = (-3.0 * l00 + 3.0 * l02 - 10.0 * l10 + 10.0 * l12 - 3.0 * l20 + 3.0 * l22) / 32.0;
    float gy = (-3.0 * l00 - 10.0 * l01 - 3.0 * l02 + 3.0 * l20 + 10.0 * l21 + 3.0 * l22) / 32.0;

    float grad = length(float2(gx, gy));
    float edge = smoothstep(threshold * 0.4, threshold * 1.4, grad);
    return saturate(edge * 2.2);
}

// Fourier Harmonic Wave outline
float get_fourier_wave(texture2d tex, float2 uv, float threshold, float p)
{
    float base_edge = get_contour(tex, uv, threshold);
    float freq = 36.0;
    float wave = sin(uv.x * freq + p * 6.28318) * cos(uv.y * freq - p * 6.28318);
    float ripple = saturate(0.5 + 0.5 * wave);
    return saturate(base_edge * (0.6 + 0.8 * ripple));
}

// Exit Phase Shader (Scene A)
float4 RenderExit(FragData f_in)
{
    float aspect = canvas_size.x / max(canvas_size.y, 1.0);
    float p = saturate(progress);

    if (exit_mode == 0) {
        // Mode 0: FadeOut with gentle kinetic shrink
        float scale = 1.0 + 0.05 * p;
        float2 uv_s = (f_in.uv - 0.5) * scale + 0.5;
        if (uv_s.x < 0.0 || uv_s.x > 1.0 || uv_s.y < 0.0 || uv_s.y > 1.0) {
            return float4(0.0, 0.0, 0.0, 0.0);
        }
        float4 c = tex_a.Sample(textureSampler, uv_s);
        float alpha = 1.0 - p;

        if (contour_mode < 2) {
            float edge = (contour_mode == 0) 
                ? get_contour(tex_a, f_in.uv, contour_sensitivity) 
                : get_fourier_wave(tex_a, f_in.uv, contour_sensitivity, p);
            float4 edge_glow = border_color * edge * p * 1.2;
            return c * alpha + edge_glow * alpha;
        }
        return c * alpha;
    } else {
        // Mode 1: Uncreate (Scene deconstructs into wireframe skeleton, then rewinds)
        float dist = get_border_distance(f_in.uv, aspect);
        float s = get_perimeter_s(f_in.uv);
        float T = border_thickness;
        float fd = clamp(fill_delay, 0.1, 0.85);

        float internal_edge = 0.0;
        if (contour_mode == 0) {
            internal_edge = get_contour(tex_a, f_in.uv, contour_sensitivity);
        } else if (contour_mode == 1) {
            internal_edge = get_fourier_wave(tex_a, f_in.uv, contour_sensitivity, p);
        }

        if (p < fd) {
            // Sub-phase 1: Scene color rapidly fades, exposing glowing wireframe skeleton
            float sub_p = p / fd;
            float4 img = tex_a.Sample(textureSampler, f_in.uv);
            float interior_alpha = saturate(1.0 - sub_p * 1.2);

            float is_border = (dist <= T) ? 1.0 : 0.0;
            float border_factor = smoothstep(T, max(T - 0.002, 0.0), dist);
            float total_edge = max(is_border * border_factor, internal_edge);
            float4 line_col = border_color * total_edge * (1.0 + glow_intensity * 0.5);

            return lerp(img * interior_alpha, line_col, total_edge * sub_p);
        } else {
            // Sub-phase 2: Wireframe lines and outer border rewind / dissolve away
            float sub_p = (p - fd) / (1.0 - fd);
            float remain_s = 4.0 * (1.0 - sub_p);

            float is_border = 0.0;
            if (dist <= T && s <= remain_s) {
                float tip_dist = max(0.0, remain_s - s);
                float glow = 1.0 + glow_intensity * exp(-tip_dist * 8.0);
                float edge_factor = smoothstep(T, max(T - 0.002, 0.0), dist);
                is_border = glow * edge_factor;
            }

            float dissolve = saturate(1.0 - sub_p * 1.4);
            float line_vis = max(is_border, internal_edge * dissolve);
            return border_color * line_vis;
        }
    }
}

// Entrance Phase Shader (Scene B)
float4 RenderEntrance(FragData f_in)
{
    float aspect = canvas_size.x / max(canvas_size.y, 1.0);
    float p = saturate(progress);

    if (enter_mode == 0) {
        // Mode 0: FadeIn with kinetic settling
        float scale = 1.0 + 0.04 * (1.0 - p);
        float2 uv_s = (f_in.uv - 0.5) * scale + 0.5;
        if (uv_s.x < 0.0 || uv_s.x > 1.0 || uv_s.y < 0.0 || uv_s.y > 1.0) {
            return float4(0.0, 0.0, 0.0, 0.0);
        }
        float4 c = tex_b.Sample(textureSampler, uv_s);
        
        if (contour_mode < 2) {
            float edge = (contour_mode == 0) 
                ? get_contour(tex_b, f_in.uv, contour_sensitivity) 
                : get_fourier_wave(tex_b, f_in.uv, contour_sensitivity, p);
            float4 edge_glow = border_color * edge * (1.0 - p) * 1.5;
            return c * p + edge_glow;
        }
        return c * p;
    } else {
        // Mode 1: Create (DrawBorderThenFill with Scene Contours)
        float dist = get_border_distance(f_in.uv, aspect);
        float s = get_perimeter_s(f_in.uv);
        float T = border_thickness;
        float fd = clamp(fill_delay, 0.1, 0.85);

        float internal_edge = 0.0;
        if (contour_mode == 0) {
            internal_edge = get_contour(tex_b, f_in.uv, contour_sensitivity);
        } else if (contour_mode == 1) {
            internal_edge = get_fourier_wave(tex_b, f_in.uv, contour_sensitivity, p);
        }

        if (p < fd) {
            // Sub-phase 1: Sketch lines are drawn first (outer perimeter + internal wireframe)
            float sub_p = p / fd;
            float draw_s = 4.0 * sub_p;

            float is_border = 0.0;
            if (dist <= T && s <= draw_s) {
                float tip_dist = max(0.0, draw_s - s);
                float glow = 1.0 + glow_intensity * exp(-tip_dist * 6.0);
                float edge_factor = smoothstep(T, max(T - 0.002, 0.0), dist);
                is_border = glow * edge_factor;
            }

            float edge_reveal = smoothstep(0.0, 0.5, sub_p);
            float internal_glow = internal_edge * edge_reveal * (1.0 + glow_intensity * 0.7);

            float total_stroke = max(is_border, internal_glow);
            return border_color * total_stroke;
        } else {
            // Sub-phase 2: Color and textures of Scene B infuse / infill into the sketch!
            float sub_p = (p - fd) / (1.0 - fd);
            float4 img = tex_b.Sample(textureSampler, f_in.uv);

            float center_dist = length((f_in.uv - 0.5) * float2(aspect, 1.0));
            float max_dist = length(float2(0.5 * aspect, 0.5));
            float norm_r = center_dist / max(max_dist, 0.0001);
            float reveal = saturate((sub_p * 1.3 - norm_r) * 4.0);

            float border_edge_factor = smoothstep(T, max(T - 0.002, 0.0), dist);
            float is_border = (dist <= T) ? 1.0 : 0.0;
            float line_retention = saturate(1.0 - sub_p * 1.2);
            float total_edge = max(is_border * border_edge_factor, internal_edge);
            float4 glowing_lines = border_color * total_edge * (1.0 + glow_intensity * 0.5);

            float4 filled_scene = img * reveal;
            return lerp(filled_scene, glowing_lines, line_retention * total_edge);
        }
    }
}

float4 PSMain(FragData f_in) : TARGET
{
    if (phase == 0) {
        return RenderExit(f_in);
    } else if (phase == 1) {
        return float4(0.0, 0.0, 0.0, 0.0);
    } else {
        return RenderEntrance(f_in);
    }
}

technique Transition
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSMain(f_in);
    }
}
